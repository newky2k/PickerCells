<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>dhpickercells</PackageId>
		<TargetFramework>net9.0-ios</TargetFramework>
		<Version>1.2.2.0</Version>
		<Product>$(AssemblyName) ($(TargetFramework))</Product>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/newky2k/PickerCells</PackageProjectUrl>
		<RepositoryUrl>https://github.com/newky2k/PickerCells</RepositoryUrl>
		<RepositoryType>Git</RepositoryType>
		<Copyright>davehumphreys</Copyright>
		<Description>This class adds UIDatePicker or UIPickerView that will slide in/out by tapping on the cell in your UITableView</Description>
		<Authors>newky2k</Authors>
		<Company>newky2k</Company>
		<PackageReleaseNotes>Updated to build with VS 2022</PackageReleaseNotes>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
</Project>